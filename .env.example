# Microsoft Teams > channel > Workflows > "When a Teams webhook request is received"
TEAMS_WEBHOOK_URL=https://prod-xx.westeurope.logic.azure.com/...

# Google Cloud service-account JSON file (do not copy the JSON into this file)
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_spreadsheet_id

# Optional dashboard protection. Leave blank for local-only use.
ADMIN_TOKEN=change-me

# Used to translate titles and summaries into Chinese.
OPENAI_API_KEY=sk-...
